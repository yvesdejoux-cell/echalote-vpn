<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon pour l'icône près de l'horloge ; types WinForms toujours qualifiés. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EchaloteVpn.App</RootNamespace>
    <AssemblyName>EchaloteVpn</AssemblyName>
    <ApplicationIcon>Assets\EchaloteVpn.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\EchaloteVpn.ico" />
    <Resource Include="Assets\logo-*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EchaloteVpn.Core\EchaloteVpn.Core.csproj" />
  </ItemGroup>

</Project>
