<Window x:Class="OnionGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnionGuard"
        Icon="Assets/OnionGuard.ico"
        Width="430" Height="660"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <!-- Texte clair hérité de la fenêtre : un style global de TextBlock s'imposerait aussi au
         texte des boutons (blanc sur le fond blanc de « Nouvelle identité »). -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- Oignon en filigrane : bulbe, pointe et couches. -->
        <Geometry x:Key="Onion">
            M 100,0 C 104,30 120,48 140,64 C 180,96 205,130 205,180 C 205,240 160,280 100,280
            C 40,280 -5,240 -5,180 C -5,130 20,96 60,64 C 80,48 96,30 100,0 Z
            M 100,30 C 104,70 150,100 165,150 C 180,205 150,255 100,262
            M 100,30 C 96,70 50,100 35,150 C 20,205 50,255 100,262
            M 100,60 C 112,110 130,160 120,210 C 115,240 106,255 100,262
            M 100,60 C 88,110 70,160 80,210 C 85,240 94,255 100,262
            M 96,0 C 90,-20 70,-40 60,-46 M 104,0 C 112,-24 130,-38 146,-44
        </Geometry>
    </Window.Resources>
    <Grid>
        <!-- Filigrane, derrière tout le reste. -->
        <Canvas ClipToBounds="True" IsHitTestVisible="False">
            <Path Data="{StaticResource Onion}" Stroke="White" StrokeThickness="9" Opacity="0.045"
                  Canvas.Left="250" Canvas.Top="70" Stretch="None" />
            <Path Data="{StaticResource Onion}" Stroke="White" StrokeThickness="9" Opacity="0.045"
                  Canvas.Left="270" Canvas.Top="420" Stretch="None" />
        </Canvas>

        <!-- Écran d'accueil, le temps que le service réponde. -->
        <Grid Visibility="{Binding ShowSplash, Converter={StaticResource Visible}}" Margin="24,20">
            <Image Source="Assets/logo-128.png" Width="64" Height="64"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                <Image Source="Assets/logo-512.png" Width="260" Height="260" />
                <TextBlock Text="OnionGuard" FontSize="32" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Text="Routage Onion global" FontSize="15" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Fenêtre principale. -->
        <Grid Margin="24,20,24,16" Visibility="{Binding ShowMain, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/logo-128.png" Width="64" Height="64" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MinHeight="34" />
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1"
                         Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                         Height="5" Margin="0,6,0,0"
                         Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}" />

            <Button Grid.Row="2" Style="{StaticResource PrimaryButton}"
                    Content="{Binding ButtonLabel}"
                    IsEnabled="{Binding CanAct}"
                    Click="MainButton_Click"
                    Width="200" Height="46" Margin="0,16,0,0" />
            <Button Grid.Row="3" Style="{StaticResource SecondaryButton}"
                    Content="Nouvelle identité"
                    IsEnabled="{Binding CanNewIdentity}"
                    Click="NewIdentity_Click"
                    Width="200" Height="34" Margin="0,10,0,0" />

            <GroupBox Grid.Row="4" Header="Réglages" Margin="0,18,0,0" Padding="14,28,14,14"
                      IsEnabled="{Binding CanEditSettings}">
                <StackPanel>
                    <TextBlock Text="Pays de sortie" FontSize="14" />
                    <ComboBox ItemsSource="{Binding Countries}"
                              SelectedItem="{Binding SelectedCountry}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Pays de sortie"
                              Margin="0,6,0,10">
                        <!-- Nom lu par les lecteurs d'écran et l'automatisation de Windows. -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <CheckBox Content="Kill switch : rien ne sort sans Tor"
                              IsChecked="{Binding KillSwitchEnabled}" />
                    <TextBlock Text="Sans kill switch, le trafic sort hors de Tor si Tor ou le tunnel tombe."
                               Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="27,3,0,0"
                               Visibility="{Binding KillSwitchWarning, Converter={StaticResource Visible}}" />
                    <CheckBox Content="Autoriser le réseau local (box, imprimante, NAS)"
                              IsChecked="{Binding AllowLocalNetwork}" Margin="0,8,0,0" />
                    <TextBlock Text="Ponts (si Tor est bloqué sur votre réseau)" FontSize="14" Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding BridgeOptions}"
                              SelectedItem="{Binding SelectedBridges}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Ponts"
                              Margin="0,6,0,0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBox Text="{Binding CustomBridgesText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowCustomBridges, Converter={StaticResource Visible}}"
                             AutomationProperties.Name="Lignes de ponts"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             Height="64" Margin="0,6,0,0" />
                    <TextBlock Text="Une ligne « obfs4 … » par pont, depuis bridges.torproject.org."
                               Visibility="{Binding ShowCustomBridges, Converter={StaticResource Visible}}"
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Appliquer" FontSize="14"
                            IsEnabled="{Binding CanApplySettings}"
                            Click="ApplySettings_Click"
                            HorizontalAlignment="Right" Width="110" Height="32" Margin="0,12,0,0" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,12">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="12" Foreground="{StaticResource FooterBrush}">
                Tout le trafic passe par Tor, mais vos applications peuvent vous trahir :
                pour un anonymat fort, utilisez le Tor Browser.
            </TextBlock>
            <!-- Dons ponctuels (Ko-fi) : un simple lien vers le navigateur. -->
            <TextBlock x:Name="DonationLink" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"
                       Visibility="Collapsed">
                <Hyperlink Click="Donation_Click" Foreground="#C79BFF" TextDecorations="None">
                    ☕ Soutenir le projet
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
